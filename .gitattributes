# Texto: fim de linha normalizado
* text=auto
*.cs text diff=csharp
*.md text
*.json text
*.asmdef text
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.mat text eol=lf
*.anim text eol=lf
*.controller text eol=lf
*.meta text eol=lf

# Binários grandes: Git LFS. PNG de pixel art ficam FORA do LFS (são pequenos; D-16 pendente).
*.wav filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.psd filter=lfs diff=lfs merge=lfs -text
*.kra filter=lfs diff=lfs merge=lfs -text
*.ttf filter=lfs diff=lfs merge=lfs -text
*.otf filter=lfs diff=lfs merge=lfs -text

# Scripts de shell precisam de LF, senão quebram no bash
*.sh text eol=lf
